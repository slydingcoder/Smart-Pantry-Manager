<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light-only theme (no DayNight), so the app stays light whatever the phone's dark-mode setting is.
         MaterialComponents (not Material3): the layouts use textAppearanceHeadline5/6, Subtitle1, Body1/2 -->
    <style name="Theme.SmartPantryManager" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/pantry_red</item>
        <item name="colorPrimaryVariant">@color/pantry_red_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/pantry_teal</item>
        <item name="colorSecondaryVariant">@color/pantry_teal_dark</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:colorBackground">@color/surface_warm</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_secondary</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>
</resources>
